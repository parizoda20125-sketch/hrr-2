
<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DON'T LOOK BACK 😈</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#000;color:white;font-family:Arial;text-align:center}
#screen{height:100vh;display:flex;align-items:center;justify-content:center;flex-direction:column;background:radial-gradient(#420000,#000);padding:20px}
h1{color:red;font-size:clamp(35px,8vw,65px);text-shadow:0 0 25px red}
p{color:#ddd}
button{background:#a00000;color:white;border:1px solid red;padding:15px 28px;font-size:18px;cursor:pointer}
video{width:100%;height:100%;object-fit:contain;background:black}
#player{display:none;position:fixed;inset:0;background:black}
#player video{width:100%;height:100%;object-fit:cover}
#sound{position:fixed;top:15px;right:15px;z-index:5;display:none}
</style>
</head>
<body>
<div id="screen">
<h1>DON'T LOOK BACK</h1>
<p>😈 Tayyor bo‘lsang, boshlash tugmasini bos...</p>
<button id="start">BOSHLASH</button>
</div>

<div id="player">
<video id="v" autoplay playsinline></video>
</div>
<button id="sound">🔊 Ovoz</button>

<script>
const clips=["horror1.mp4","horror2.mp4 ,horror3.mp4 , horror4.mp4"];
let n=0;
const v=document.getElementById("v");
const player=document.getElementById("player");
const sound=document.getElementById("sound");

document.getElementById("start").onclick=()=>{
 document.getElementById("screen").style.display="none";
 player.style.display="block";
 sound.style.display="block";
 n=0;
 playClip();
};

function playClip(){
 v.src=clips[n];
 v.muted=false;
 v.load();
 v.play().catch(()=>{
   v.muted=true;
   v.play().catch(()=>alert("Video fayllarini tekshir!"));
 });
}

v.onended=()=>{
 n++;
 if(n<clips.length){
   player.style.background="white";
   setTimeout(()=>{
     player.style.background="black";
     playClip();
   },150);
 }else{
   player.style.display="none";
   sound.style.display="none";
   document.getElementById("screen").style.display="flex";
   document.querySelector("#screen h1").textContent="YOU SURVIVED 😈";
   document.querySelector("#screen p").textContent="Tugadi... qayta boshlashga jur'at bormi?";
 }
};

sound.onclick=()=>{
 v.muted=!v.muted;
 sound.textContent=v.muted?"🔇 Ovoz yoqish":"🔊 Ovoz o‘chirish";
};
</script>
</body>
</html>
